# Set APP_DATA_MODE=fixture to run the deterministic demo without external credentials.
APP_DATA_MODE=fixture

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_ORGANIZATION_ID=

# Amadeus Self-Service credentials. Leave blank in fixture mode.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# OpenAI and Sanity Context MCP. Leave blank to return a safe degraded comparison.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
SANITY_CONTEXT_MCP_URL=
SANITY_CONTEXT_TOKEN=
